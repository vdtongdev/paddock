{
  "mcpServers": {
    "paddock-mem": {
      "command": "uv",
      "args": [
        "run",
        "--no-project",
        "--script",
        "scripts/paddock_core/mcp_server.py"
      ],
      "env": {
        "PYTHONUTF8": "1"
      }
    },
    "paddock-worktree": {
      "command": "uv",
      "args": [
        "run",
        "--no-project",
        "--script",
        "scripts/paddock_core/worktree_mcp_server.py"
      ],
      "env": {
        "PYTHONUTF8": "1"
      }
    }
  }
}
